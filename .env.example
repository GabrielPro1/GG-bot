# Bot Telegram
TELEGRAM_BOT_TOKEN=

# Identificativi owner di WhatsApp (jid LID/PN separati da virgola).
# Es: BOT_OWNERS=1234@lid,999@s.whatsapp.net
BOT_OWNERS=

# Verbosità dei log interni di Baileys. Predefinito: silent, così i messaggi
# dei canali/newsletter non riempiono il terminale. Valori: silent, error,
# warn, info, debug.
#BAILEYS_LOG_LEVEL=silent

# ─────────────────────────────────────────────
# Dashboard owner (web + comando /dashboard)
# ─────────────────────────────────────────────
# Password per accedere alla dashboard web.
# È obbligatoria: senza questa variabile la dashboard non parte.
DASHBOARD_PASSWORD=

# Porta HTTP della dashboard (predefinita 3000).
#DASHBOARD_PORT=3000

# Indirizzo di ascolto: 127.0.0.1 (predefinito, solo questo PC) oppure
# 0.0.0.0 per consentire l'accesso dalla LAN.
#DASHBOARD_HOST=127.0.0.1

# Compatibilità: se DASHBOARD_PASSWORD è vuota, viene usata DASHBOARD_TOKEN.
#DASHBOARD_TOKEN=

# Chiave API Google Gemini (livello gratuito). Lascia vuoto per tenere il bot
# attivo senza la funzionalità AI (.ai).
GEMINI_API_KEY=

# Modello Gemini usato dalla funzionalità AI. Predefinito: gemini-3.1-flash-lite (livello gratuito).
GEMINI_MODEL=gemini-3.1-flash-lite
