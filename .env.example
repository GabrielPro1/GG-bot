# Telegram Bot
TELEGRAM_BOT_TOKEN=

# WhatsApp OWNER identifiers (comma-separated LID/PN jids).
# Es: BOT_OWNERS=1234@lid,999@s.whatsapp.net
BOT_OWNERS=

# Google Gemini API key (free tier). Leave empty to keep the bot running with
# the AI (.ai) feature disabled.
GEMINI_API_KEY=

# Gemini model used by the AI feature. Defaults to gemini-3.1-flash-lite (free tier).
GEMINI_MODEL=gemini-3.1-flash-lite
