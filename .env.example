# Telegram Bot
TELEGRAM_BOT_TOKEN=

# WhatsApp OWNER identifiers (comma-separated LID/PN jids).
# Es: BOT_OWNERS=1234@lid,999@s.whatsapp.net
BOT_OWNERS=

# Root folder for WhatsApp auth/session data (main session files + per-user
# Telegram session subfolders). Defaults to ./auth.
# Su Render: monta un Persistent Disk e punta qui, es:
# WHATSAPP_AUTH_ROOT=/var/data/auth
WHATSAPP_AUTH_ROOT=auth

# Port for the Render health-check HTTP server.
PORT=3000
