# Bot Telegram
TELEGRAM_BOT_TOKEN=

# Identificativi owner di WhatsApp (jid LID/PN separati da virgola).
# Es: BOT_OWNERS=1234@lid,999@s.whatsapp.net
BOT_OWNERS=

# Chiave API Google Gemini (livello gratuito). Lascia vuoto per tenere il bot
# attivo senza la funzionalità AI (.ai).
GEMINI_API_KEY=

# Modello Gemini usato dalla funzionalità AI. Predefinito: gemini-3.1-flash-lite (livello gratuito).
GEMINI_MODEL=gemini-3.1-flash-lite


# ─────────────────────────────────────────────
# Libreria PDF scolastica (/mandapag e /libri)
# ─────────────────────────────────────────────
# Tutte le variabili sotto sono opzionali: i valori mostrati sono i predefiniti.

# Quante pagine al massimo in una sola richiesta /mandapag (predefinito 15).
#PDF_MAX_PAGES_PER_REQUEST=15

# Scala di rendering del PDF. 2 ≈ 144 DPI su A4; più alto = più nitido ma più pesante.
#PDF_RENDER_SCALE=2

# Renderer da usare: pdfjs (predefinito) oppure mupdf (sperimentale, richiede `npm i mupdf`).
#PDF_RENDERER=pdfjs

# Quante pagine renderizzare in parallelo (predefinito 3).
#PDF_MAX_CONCURRENT_RENDERS=3

# Ritardo in millisecondi tra un invio e il successivo (predefinito 600).
#PDF_SEND_DELAY_MS=600

# Formato immagine delle pagine: jpeg (predefinito) o png.
#PDF_IMAGE_FORMAT=jpeg

# Qualità JPEG da 1 a 100 (predefinito 82).
#PDF_JPEG_QUALITY=82

# Dimensione massima di un PDF accettato, in byte (predefinito 200 MB = 209715200).
#PDF_MAX_BYTES=209715200

# Dimensione massima di una singola immagine inviata a WhatsApp, in byte (predefinito 10 MB = 10485760).
#PDF_MAX_IMAGE_BYTES=10485760

# Cache delle pagine su disco: true (predefinito) o false. La cache vive in data/pdf-cache (gitignored).
#PDF_CACHE_ENABLED=true

# Dimensione massima della cache, in byte (predefinito 300 MB = 314572800).
#PDF_CACHE_MAX_BYTES=314572800

# Età massima di una voce in cache, in millisecondi (predefinito 7 giorni = 604800000).
#PDF_CACHE_MAX_AGE_MS=604800000
