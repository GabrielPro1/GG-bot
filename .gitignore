libri/*.pdf
libri/*.PDF

# Backups
backups/

# Logs
logs/
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Editor folders
.vscode/
.idea/

# Local agent instructions (kept out of version control)
AGENTS.md
