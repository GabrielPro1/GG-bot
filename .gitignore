# Dependencies
node_modules/

# Environment variables / secrets
.env
.env.*
!.env.example

# WhatsApp authentication/session data
auth/

# SQLite database + runtime data (RPG players, identities, AI chat history:
# ai_chats / ai_messages tables). Contains sensitive user conversation data;
# NEVER commit anything under data/.
data/

